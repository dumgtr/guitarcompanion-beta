++            }
++            if (-not $restored) {
++                Throw-GcFailureV2 -ReasonCode 'EVIDENCE_WRITE_FAILED' -FieldId 'evidence.rollback' -PolicyRuleId 'V2-EVIDENCE-ROLLBACK' -FailureCategory 'evidence'
