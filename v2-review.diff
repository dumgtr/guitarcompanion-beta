++        throw $failure
++    }
++    finally {
++        if ([IO.File]::Exists($temporaryPath)) { try { [IO.File]::Delete($temporaryPath) } catch { } }
++        if ([IO.File]::Exists($backupPath)) { try { [IO.File]::Delete($backupPath) } catch { } }
++    }
++}
