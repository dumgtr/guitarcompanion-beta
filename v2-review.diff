++function Write-GcEvidenceAtomicV2 {
++    param(
++        [Parameter(Mandatory)]$Evidence,
++        [Parameter(Mandatory)][string]$DestinationPath,
++        [Parameter(Mandatory)]$Policy,
++        [Parameter(Mandatory)][string]$RouterScriptPath,
