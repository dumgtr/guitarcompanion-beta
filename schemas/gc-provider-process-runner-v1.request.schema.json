{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc-provider-process-runner-v1.request/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "taskId",
    "providerProfileId",
    "repositoryRoot",
    "expectedBranch",
    "expectedHead",
    "promptPath",
    "promptSha256",
    "routerDecisionSha256",
    "timeoutMilliseconds",
    "retryIntent",
    "resumeCheckpointPath",
    "resumeCheckpointSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "gc-provider-process-runner-v1.request/1" },
    "requestId": { "type": "string", "pattern": "^GC_RUN_[0-9a-f]{32}$" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providerProfileId": { "enum": ["codex-readonly", "gemini-plan-review", "claude-readonly", "github-copilot-readonly"] },
    "repositoryRoot": { "type": "string", "minLength": 3 },
    "expectedBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "expectedHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "promptPath": { "type": "string", "minLength": 3 },
    "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "routerDecisionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timeoutMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "retryIntent": { "type": "boolean" },
    "resumeCheckpointPath": { "type": ["string", "null"] },
    "resumeCheckpointSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  }
}
