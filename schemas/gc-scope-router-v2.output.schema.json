{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc-scope-router-v2.output/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "policyVersion",
    "executionPermitted",
    "autoRepairAllowed",
    "inputByteLength",
    "inputSha256",
    "decisionContentSha256"
  ],
  "properties": {
    "artifactType": { "enum": ["decision", "rejection"] },
    "schemaVersion": { "const": "gc-scope-router-v2.output/1" },
    "policyVersion": { "const": "gc-scope-router-v2.policy/1" },
    "executionPermitted": { "const": false },
    "autoRepairAllowed": { "const": false },
    "inputByteLength": { "type": "integer", "minimum": 0 },
    "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decisionContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taskId": { "type": "string" },
    "repositoryIdentity": { "type": "object" },
    "classification": { "enum": ["simple", "moderate", "complex", "critical", "blocked"] },
    "route": { "enum": ["fast-path", "planned-path", "architecture-path", "critical-controlled-path", "blocked-path"] },
    "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "recommendedWriter": { "type": ["string", "null"] },
    "reviewers": { "type": "array", "items": { "type": "object" } },
    "allowedReadPaths": { "type": "array", "items": { "type": "string" } },
    "allowedWritePaths": { "type": "array", "items": { "type": "string" } },
    "authorizedProtectedWritePaths": { "type": "array", "items": { "type": "string" } },
    "protectedWriteAuthorization": {
      "type": ["object", "null"],
      "properties": {
        "authorizationId": { "type": "string", "pattern": "^GC_PWA_[0-9a-f]{32}$" },
        "authorizationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reviewRequired": { "const": true }
      },
      "required": ["authorizationId", "authorizationSha256", "reviewRequired"],
      "additionalProperties": false
    },
    "forbiddenPaths": { "type": "array", "items": { "type": "string" } },
    "protectedNamespaces": { "type": "array", "items": { "type": "string" } },
    "dirtyState": { "type": "object" },
    "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contractsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reasonCode": { "type": "string" },
    "fieldId": { "type": "string" },
    "arrayIndex": { "type": ["integer", "null"] },
    "policyRuleId": { "type": "string" },
    "failureCategory": { "type": "string" }
  }
}
