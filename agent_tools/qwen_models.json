      "status": "allowed",
      "selectionMode": "auto",
      "autoSelectable": true,
      "tier": "cheapest",
      "requestDefaults": {
        "enable_thinking": false
      },
      "useFor": [
        "minimal cost checks",
        "basic greeting and simple trace"
      ],
      "doNotUseFor": [
        "complex code paths",
        "deterministic gates"
      ]
    },
